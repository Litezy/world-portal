# Public — inlined into the browser bundle at build time.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WorldStreet sign-in. E-Embassy shares WorldStreet's Clerk instance — use the
# SAME keys the WorldStreet app uses (dev keys locally, live keys in
# production). A different instance means a different session and applicants
# will loop on sign-in. The publishable key is inlined at build time.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Where signed-out applicants are sent. Defaults to the production hub; point
# these at a local WorldStreet (e.g. http://localhost:3001/login) to develop
# both apps together.
# NEXT_PUBLIC_WORLDSTREET_URL=https://www.worldstreetgold.com
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=https://www.worldstreetgold.com/login
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=https://www.worldstreetgold.com/register
# Vivid — WorldStreet's voice assistant (server-side only). The SAME Sira key
# the WorldStreet app uses; the browser only ever gets a one-minute session
# token. Unset: the orb shows but a session answers "unavailable".
SIRA_API_KEY=
# SIRA_API_URL=https://sira.vividintelligence.tech
# Vivid is free on E-Embassy. "true" requires WorldStreet's paid Vivid
# subscription — see src/server/vivid/access.ts before switching it on.
# VIVID_REQUIRE_SUBSCRIPTION=false
# Playwright: an existing user in the WorldStreet Clerk DEV instance. With it
# (and dev keys above) the signed-in /apply specs run; without it they skip.
# E2E_CLERK_USER_EMAIL=

# The World Portal backend, INCLUDING its /api prefix. Used by the public visa
# flow (/apply, /track) from the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# NEXT_PUBLIC_GA_ID=

# Same backend, read server-side by the admin console. The console proxies every
# call through its own route handlers so the access token stays in an httpOnly
# cookie and never reaches the browser. Defaults to NEXT_PUBLIC_API_URL.
# WORLD_PORTAL_API_URL=http://localhost:4000/api

# Admin console (/admin). Sign in with an email that has an active Profile on
# the backend — `prisma/seed.ts` there creates manager@loveworld.com. The
# password is a shared console gate until the real identity provider issues
# tokens directly; src/config/env.ts refuses both defaults in production.
# Generate a secret with: openssl rand -base64 32
ADMIN_EMAIL=manager@loveworld.com
ADMIN_PASSWORD=worldportal
SESSION_SECRET=world-portal-dev-session-secret

# Agency console (/agency). A separate audience from /admin — an outside
# business, on its own cookie, that must never reach the admin desk. There is
# no agency identity provider yet, so this is one shared password checked
# against the fixture agencies in src/features/agency/fixtures.ts; sign in with
# any address listed there, e.g. adaeze@sentinelridge.example. Like
# ADMIN_PASSWORD, src/config/env.ts refuses the default in production.
AGENCY_PASSWORD=worldportal-agency

# WorldSpace — the sister social platform under the same parent company
# (Tsion), where travellers post about the trips they have taken. This is the
# public origin the landing section links out to. The default in
# src/config/env.ts is an obvious placeholder; set this to the real WorldSpace
# origin before launch.
NEXT_PUBLIC_WORLDSPACE_URL=https://worldspace.example

# The WorldSpace posts API, read server-side only so any key it eventually
# needs never reaches the browser. LEAVING THIS UNSET IS SUPPORTED and is the
# state today: WorldSpace has no public API yet, so the feed falls back to the
# curated placeholder posts in src/features/worldspace/fixtures.ts. Setting it
# is the whole swap to the live feed — see src/server/worldspace/client.ts.
# WORLDSPACE_API_URL=https://api.worldspace.example
