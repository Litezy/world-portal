# This repo houses two projects (worldPortal backend, world-portal-frontend
# frontend), each with its own .gitignore scoped to its own tree for
# framework-specific paths. This file is a repo-wide safety net so nothing
# generated or sensitive gets tracked no matter which subproject (or any
# future one) produces it.

# dependencies
node_modules/

# env files
.env
.env.*
!.env.example
!*/.env.example

# build output
dist/
build/
out/
.next/

# test coverage / reports
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# typescript incremental build info
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db
