# Public — inlined into the browser bundle at build time.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The World Portal backend, INCLUDING its /api prefix. Required by the visa
# flow (/apply, /track). It is a Cloudflare Quick Tunnel, so the host changes
# every time the tunnel restarts — keep it here, never in code.
NEXT_PUBLIC_API_URL=

# NEXT_PUBLIC_GA_ID=

# Admin console (/admin). These development defaults let a fresh clone sign in;
# src/config/env.ts refuses both in production, so set real values before
# deploying or the build fails. Generate a secret with: openssl rand -base64 32
ADMIN_EMAIL=admin@worldportal.travel
ADMIN_PASSWORD=worldportal
SESSION_SECRET=world-portal-dev-session-secret
