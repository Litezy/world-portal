// Prisma Schema for World Portal

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MANAGER
  PARTNER
  STAFF
}

enum VisaDocumentStatus {
  SUBMITTED
  EVALUATED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING_EVALUATION
  AWAITING_PAYMENT
  PARTIALLY_PAID
  FULLY_PAID
  REFUNDED
}

enum PaymentOption {
  FULL
  HALF_INSTALLMENT
}

enum VisaCategory {
  TOURIST
  BUSINESS
  STUDENT
  WORK
  TRANSIT
}

enum Gender {
  MALE
  FEMALE
}

enum PassportCategory {
  FRESH
  RENEWAL
  DAMAGE
  MARRIAGE
  DIVORCE
}

enum PassportValidity {
  FIVE_YEARS
  TEN_YEARS
}

enum BookletType {
  THIRTY_TWO_PAGES
  SIXTY_FOUR_PAGES
}

enum PassportApplicationStatus {
  SUBMITTED
  EVALUATED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model Profile {
  id                   String                @id @default(uuid())
  externalAuthId       String?               @unique
  email                String                @unique
  firstName            String
  lastName             String
  phone                String?
  role                 UserRole              @default(STAFF)
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  visaDocumentations   VisaDocumentation[]
  paymentTransactions  PaymentTransaction[]
  passportApplications PassportApplication[]
  hireBookings         HireBooking[]

  @@index([email])
  @@index([role])
}

model VisaDocumentation {
  id            String  @id @default(uuid())
  applicationNo String  @unique
  profileId     String?

  // Applicant Personal Information
  firstName        String
  lastName         String
  email            String
  phone            String
  dateOfBirth      DateTime
  gender           Gender   @default(MALE)
  nationality      String
  residenceAddress String

  // Passport Details
  passportNumber           String
  passportIssueDate        DateTime
  passportExpiryDate       DateTime
  passportIssuingAuthority String?

  // Travel & Visa Application Details
  targetCountry         String
  visaCategory          VisaCategory @default(TOURIST)
  intendedArrivalDate   DateTime
  intendedDepartureDate DateTime
  purposeOfVisit        String

  // Required Document Attachments (S3 URLs)
  passportDataPageUrl     String
  passportPhotoWhiteBgUrl String
  proofOfFunds6MonthsUrl  String

  // Optional Document Attachments (S3 URLs)
  businessRegistrationCertUrl String?
  taxCertificateUrl           String?
  marriageCertificateUrl      String?
  childrenBirthCertUrls       String[] @default([])
  landedPropertyDocUrls       String[] @default([])
  previousVisasScanUrls       String[] @default([])
  supportingDocUrls           String[] @default([])

  // Admin Cost Evaluation & Payment Allocation
  totalAmount           Decimal?       @db.Decimal(10, 2)
  currency              String         @default("USD")
  amountPaid            Decimal        @default(0.00) @db.Decimal(10, 2)
  balanceDue            Decimal        @default(0.00) @db.Decimal(10, 2)
  allowInstallment      Boolean        @default(false)
  selectedPaymentOption PaymentOption?
  paymentStatus         PaymentStatus  @default(PENDING_EVALUATION)
  evaluatedBy           String?
  evaluatedAt           DateTime?

  // Processing Lifecycle & Audit
  status            VisaDocumentStatus @default(SUBMITTED)
  verificationNotes String?
  rejectionReason   String?
  createdBy         String
  reviewedBy        String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  profile             Profile?             @relation(fields: [profileId], references: [id], onDelete: SetNull)
  paymentTransactions PaymentTransaction[]
  hireBookings        HireBooking[]

  @@index([profileId])
  @@index([status])
  @@index([paymentStatus])
  @@index([passportNumber])
  @@index([applicationNo])
  @@index([email])
}

model PassportApplication {
  id            String  @id @default(uuid())
  applicationNo String  @unique
  profileId     String?

  // Passport Category (Nigeria Immigration Service e-Passport Data Form)
  passportCategory PassportCategory

  // Personal Information
  surname                String
  firstName              String
  middleName             String?
  sex                    Gender
  ninNumber              String
  dateOfBirth            DateTime
  placeOfBirth           String
  existingPassportNumber String?
  homeTown               String
  stateOfOrigin          String
  permanentAddress       String
  occupation             String
  contactPhone           String
  email                  String

  // Personal Features
  maritalStatus         String
  colourOfEyes          String
  colourOfHair          String
  height                String
  maidenName            String?
  nextOfKinName         String
  nextOfKinPhone        String
  nextOfKinRelationship String
  nextOfKinAddress      String

  // Passport Information
  validity    PassportValidity
  bookletType BookletType

  // Required Document Attachments (S3/Cloudinary URLs)
  birthCertificateUrl String
  ninDocumentUrl      String
  passportPhotoUrl    String

  // Admin Cost Evaluation & Payment Allocation
  totalAmount           Decimal?       @db.Decimal(10, 2)
  currency              String         @default("USD")
  amountPaid            Decimal        @default(0.00) @db.Decimal(10, 2)
  balanceDue            Decimal        @default(0.00) @db.Decimal(10, 2)
  allowInstallment      Boolean        @default(false)
  selectedPaymentOption PaymentOption?
  paymentStatus         PaymentStatus  @default(PENDING_EVALUATION)
  evaluatedBy           String?
  evaluatedAt           DateTime?

  // Processing Lifecycle & Audit
  status            PassportApplicationStatus @default(SUBMITTED)
  verificationNotes String?
  rejectionReason   String?
  createdBy         String
  reviewedBy        String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  profile             Profile?             @relation(fields: [profileId], references: [id], onDelete: SetNull)
  paymentTransactions PaymentTransaction[]

  @@index([profileId])
  @@index([status])
  @@index([paymentStatus])
  @@index([ninNumber])
  @@index([applicationNo])
  @@index([email])
}

enum PaymentTransactionStatus {
  INITIATED
  CONFIRMED
  FAILED
  REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSED
  REJECTED
}

model PaymentConfig {
  id                        String   @id @default(uuid())
  partnerMarkupPercentage   Decimal  @default(10.00) @db.Decimal(5, 2)
  serviceFeePercentage      Decimal  @default(5.00) @db.Decimal(5, 2)
  refundSurchargePercentage Decimal  @default(15.00) @db.Decimal(5, 2)
  updatedBy                 String
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model PaymentTransaction {
  id                    String                   @id @default(uuid())
  transactionRef        String                   @unique
  visaDocumentationId   String?
  passportApplicationId String?
  agencyAssignmentId    String?
  hireBookingId         String?
  profileId             String?
  packageItemsJson      Json?
  amount                Decimal                  @db.Decimal(10, 2)
  paymentOption         PaymentOption
  status                PaymentTransactionStatus @default(INITIATED)
  paymentMethod         String?                  @default("CARD")
  initiatedBy           String
  confirmedAt           DateTime?
  refundedAt            DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  visaDocumentation   VisaDocumentation?   @relation(fields: [visaDocumentationId], references: [id], onDelete: SetNull)
  passportApplication PassportApplication? @relation(fields: [passportApplicationId], references: [id], onDelete: SetNull)
  profile             Profile?             @relation(fields: [profileId], references: [id], onDelete: SetNull)
  hireBooking         HireBooking?         @relation(fields: [hireBookingId], references: [id], onDelete: SetNull)
  refunds             PaymentRefund[]

  @@index([visaDocumentationId])
  @@index([passportApplicationId])
  @@index([agencyAssignmentId])
  @@index([hireBookingId])
  @@index([profileId])
  @@index([status])
  @@index([transactionRef])
}

model PaymentRefund {
  id              String       @id @default(uuid())
  refundRef       String       @unique
  transactionId   String
  originalAmount  Decimal      @db.Decimal(10, 2)
  surchargeAmount Decimal      @db.Decimal(10, 2)
  netRefundAmount Decimal      @db.Decimal(10, 2)
  reason          String
  status          RefundStatus @default(REQUESTED)
  processedBy     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  transaction PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([status])
}

model BankAccount {
  id            String   @id @default(uuid())
  bankName      String
  accountName   String
  accountNumber String
  swiftCode     String?
  iban          String?
  routingNumber String?
  currency      String   @default("USD")
  instructions  String?
  isActive      Boolean  @default(true)
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive])
}

// ==========================================
// AGENCY PORTAL MODELS & ENUMS
// ==========================================

enum AgencyVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  SUSPENDED
}

enum AgencyListingStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  LIVE
  REJECTED
  PAUSED
}

enum AgencyUserRole {
  OWNER
  MANAGER
  COORDINATOR
}

enum AgencyStaffStatus {
  AVAILABLE
  ASSIGNED
  OFF_DUTY
  INACTIVE
}

enum AssignmentStatus {
  REQUESTED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AgencyPayoutStatus {
  PENDING
  PROCESSING
  PAID
  ON_HOLD
}

enum AgencyDocumentKind {
  BUSINESS_REGISTRATION
  TAX_CERTIFICATE
  PROOF_OF_ADDRESS
  OWNER_ID
  LIABILITY_INSURANCE
  SECURITY_OPERATING_LICENCE
  GUARD_TRAINING_CERTIFICATES
  FOOD_HYGIENE_CERTIFICATE
  KITCHEN_INSPECTION_REPORT
  FLEET_INSURANCE
  VEHICLE_REGISTRATION
  DRIVER_LICENCES
  CHEMICAL_HANDLING_ASSESSMENT
  TOUR_GUIDE_LICENCE
  FIRST_AID_CERTIFICATE
  INTERPRETER_ACCREDITATION
  CHILDCARE_BACKGROUND_CHECKS
  CUSTOMS_BROKER_LICENCE
  EVENT_PUBLIC_LIABILITY
  MEDICAL_PRACTITIONER_LICENCE
}

enum AgencyDocumentStatus {
  MISSING
  UPLOADED
  IN_REVIEW
  APPROVED
  REJECTED
}

model Agency {
  id                 String                   @id @default(uuid())
  slug               String                   @unique
  name               String
  legalName          String
  registrationNumber String?
  countryCode        String
  country            String
  cities             String[]
  categories         String[]
  summary            String
  about              String                   @db.Text
  logoUrl            String?
  email              String
  phone              String
  website            String?
  yearFounded        Int
  staffCount         Int                      @default(1)
  languages          String[]
  verification       AgencyVerificationStatus @default(UNVERIFIED)
  listingStatus      AgencyListingStatus      @default(DRAFT)
  rating             Decimal?                 @db.Decimal(3, 2)
  completedJobs      Int                      @default(0)
  commissionRate     Decimal                  @default(0.15) @db.Decimal(5, 4)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  users              AgencyUser[]
  documents          AgencyDocument[]
  offerings          AgencyServiceOffering[]
  staff              AgencyStaff[]
  assignments        AgencyAssignment[]
  payouts            AgencyPayout[]

  @@index([slug])
  @@index([countryCode])
  @@index([verification])
  @@index([listingStatus])
}

model AgencyUser {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String?
  role         AgencyUserRole @default(MANAGER)
  agencyId     String
  agency       Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([email])
  @@index([agencyId])
}

model AgencyDocument {
  id         String               @id @default(uuid())
  agencyId   String
  kind       AgencyDocumentKind
  status     AgencyDocumentStatus @default(MISSING)
  fileName   String?
  fileUrl    String?
  uploadedAt DateTime?
  expiresAt  DateTime?
  note       String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@index([kind])
  @@index([status])
}

model AgencyServiceOffering {
  id            String   @id @default(uuid())
  agencyId      String
  category      String
  title         String
  description   String   @db.Text
  price         Decimal? @db.Decimal(10, 2)
  currency      String   @default("USD")
  unit          String
  leadTimeHours Int      @default(24)
  capacity      Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@index([category])
}

model AgencyStaff {
  id                String            @id @default(uuid())
  agencyId          String
  name              String
  role              String
  category          String
  photoUrl          String?
  phone             String
  languages         String[]
  experienceYears   Int               @default(0)
  status            AgencyStaffStatus @default(AVAILABLE)
  backgroundChecked Boolean           @default(false)
  rating            Decimal?          @db.Decimal(3, 2)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@index([category])
  @@index([status])
}

model AgencyAssignment {
  id                     String           @id @default(uuid())
  reference              String           @unique
  agencyId               String
  category               String
  offeringId             String
  offeringTitle          String
  travellerName          String
  travellerEmail         String?
  travellerPhone         String?
  partySize              Int              @default(1)
  destinationCity        String
  destinationCountry     String
  destinationCountryCode String
  startsAt               DateTime
  endsAt                 DateTime
  status                 AssignmentStatus @default(REQUESTED)
  assignedStaffIds       String[]
  staffRequired          Int              @default(1)
  notes                  String?          @db.Text
  gross                  Decimal          @db.Decimal(10, 2)
  currency               String           @default("USD")
  platformFee            Decimal          @db.Decimal(10, 2)
  netToAgency            Decimal          @db.Decimal(10, 2)
  payoutId               String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  agency Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  payout AgencyPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([agencyId])
  @@index([reference])
  @@index([status])
  @@index([payoutId])
}

model AgencyPayout {
  id                 String             @id @default(uuid())
  reference          String             @unique
  agencyId           String
  periodStart        DateTime
  periodEnd          DateTime
  gross              Decimal            @db.Decimal(10, 2)
  platformFee        Decimal            @db.Decimal(10, 2)
  net                Decimal            @db.Decimal(10, 2)
  currency           String             @default("USD")
  status             AgencyPayoutStatus @default(PENDING)
  paidAt             DateTime?
  destinationAccount String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  agency      Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  assignments AgencyAssignment[]

  @@index([agencyId])
  @@index([reference])
  @@index([status])
}

// ==========================================
// HIRE & PROFESSIONAL SERVICES MODELS & ENUMS
// ==========================================

enum HireBookingStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model ProfessionalProfile {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  title         String
  category      String
  bio           String   @db.Text
  avatarUrl     String?
  countryCode   String
  country       String
  hourlyRate    Decimal  @db.Decimal(10, 2)
  currency      String   @default("USD")
  languages     String[]
  rating        Decimal? @db.Decimal(3, 2)
  completedJobs Int      @default(0)
  isVerified    Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings HireBooking[]
  ratings  ProfessionalRating[]

  @@index([slug])
  @@index([category])
  @@index([countryCode])
  @@index([isVerified])
}

model HireBooking {
  id                  String            @id @default(uuid())
  reference           String            @unique
  professionalId      String
  profileId           String?
  visaDocumentationId String?
  travellerName       String
  travellerEmail      String
  travellerPhone      String?
  destinationCity     String
  startsAt            DateTime
  endsAt              DateTime
  status              HireBookingStatus @default(REQUESTED)
  totalAmount         Decimal           @db.Decimal(10, 2)
  currency            String            @default("USD")
  notes               String?           @db.Text
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  professional      ProfessionalProfile  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  profile           Profile?             @relation(fields: [profileId], references: [id], onDelete: SetNull)
  visaDocumentation VisaDocumentation?   @relation(fields: [visaDocumentationId], references: [id], onDelete: SetNull)
  paymentTransactions PaymentTransaction[]

  @@index([reference])
  @@index([professionalId])
  @@index([profileId])
  @@index([visaDocumentationId])
  @@index([status])
  @@index([travellerEmail])
}

model ProfessionalRating {
  id             String   @id @default(uuid())
  professionalId String
  reviewerName   String
  rating         Int
  reviewText     String?  @db.Text
  createdAt      DateTime @default(now())

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
}
