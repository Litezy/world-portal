<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <meta name="supported-color-schemes" content="light dark">
  <title>Admin Team Invitation</title>
  <style>
    :root {
      color-scheme: light dark;
      supported-color-schemes: light dark;
    }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #f8fafc; color: #0f172a; margin: 0; padding: 24px; }
    .container { max-width: 580px; margin: 0 auto; background-color: #ffffff; border-radius: 16px; border: 1px solid #e2e8f0; overflow: hidden; padding: 32px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -2px rgba(0,0,0,0.05); }
    .header { text-align: center; padding-bottom: 24px; border-bottom: 1px solid #e2e8f0; }
    .logo { font-size: 20px; font-weight: 700; color: #9333ea; letter-spacing: -0.02em; text-transform: uppercase; }
    .title { font-size: 22px; font-weight: 700; color: #0f172a; margin-top: 16px; margin-bottom: 8px; }
    .subtitle { font-size: 14px; color: #64748b; margin: 0; }
    .content { padding: 24px 0; }
    .text-greeting { font-size: 15px; color: #1e293b; font-weight: 600; }
    .text-body { font-size: 14px; color: #475569; line-height: 1.6; }
    .invite-card { background-color: #faf5ff; border: 1.5px solid #a855f7; border-radius: 12px; padding: 20px; text-align: center; margin: 20px 0; }
    .role-badge { display: inline-block; background-color: rgba(168, 85, 247, 0.15); color: #7e22ce; font-weight: 700; font-size: 13px; padding: 4px 14px; border-radius: 9999px; text-transform: uppercase; letter-spacing: 0.05em; }
    .info-table { width: 100%; border-collapse: collapse; margin-top: 16px; }
    .info-table td { padding: 10px 0; border-bottom: 1px solid #e2e8f0; font-size: 14px; }
    .info-label { color: #64748b; }
    .info-value { color: #0f172a; font-weight: 600; text-align: right; }
    .btn-container { text-align: center; margin-top: 28px; }
    .btn { display: inline-block; background-color: #9333ea; color: #ffffff !important; text-decoration: none; font-weight: 600; font-size: 14px; padding: 14px 32px; border-radius: 9999px; }
    .footer { text-align: center; font-size: 12px; color: #64748b; margin-top: 32px; padding-top: 16px; border-top: 1px solid #e2e8f0; }

    @media (prefers-color-scheme: dark) {
      body { background-color: #0f172a !important; color: #f8fafc !important; }
      .container { background-color: #1e293b !important; border-color: #334155 !important; }
      .header { border-bottom-color: #334155 !important; }
      .logo { color: #c084fc !important; }
      .title { color: #ffffff !important; }
      .subtitle { color: #94a3b8 !important; }
      .text-greeting { color: #f8fafc !important; }
      .text-body { color: #94a3b8 !important; }
      .invite-card { background-color: #0f172a !important; border-color: #a855f7 !important; }
      .role-badge { background-color: rgba(168, 85, 247, 0.25) !important; color: #c084fc !important; }
      .info-table td { border-bottom-color: #334155 !important; }
      .info-label { color: #94a3b8 !important; }
      .info-value { color: #ffffff !important; }
      .footer { color: #64748b !important; border-top-color: #334155 !important; }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <div class="logo">World Portal Console</div>
      <h1 class="title">Admin Team Invitation</h1>
      <p class="subtitle">You have been invited to join the World Portal Console team.</p>
    </div>

    <div class="content">
      <p class="text-greeting">Hello <%= recipient_name %>,</p>
      <p class="text-body">
        An administrator has invited you to join the World Portal Console team as a <strong><%= role %></strong>.
      </p>

      <div class="invite-card">
        <div style="font-size: 12px; text-transform: uppercase; color: #6b21a8; font-weight: 600; margin-bottom: 8px;">Assigned System Role</div>
        <div class="role-badge"><%= role %></div>
      </div>

      <table class="info-table">
        <tr>
          <td class="info-label">Account Email</td>
          <td class="info-value"><%= to_email %></td>
        </tr>
        <tr>
          <td class="info-label">Invited By</td>
          <td class="info-value"><%= inviter_email %></td>
        </tr>
      </table>

      <div class="btn-container">
        <a href="<%= login_url %>" class="btn">Accept Invitation & Access Console</a>
      </div>
    </div>

    <div class="footer">
      <p>© <%= year %> The Trade Factor / World Portal. All rights reserved.</p>
      <p>Sent from <%= from_email %></p>
    </div>
  </div>
</body>
</html>
