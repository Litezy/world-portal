<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <meta name="supported-color-schemes" content="light dark">
  <title>Application Status Update</title>
  <style>
    :root {
      color-scheme: light dark;
      supported-color-schemes: light dark;
    }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #f8fafc; color: #0f172a; margin: 0; padding: 24px; }
    .container { max-width: 580px; margin: 0 auto; background-color: #ffffff; border-radius: 16px; border: 1px solid #e2e8f0; overflow: hidden; padding: 32px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -2px rgba(0,0,0,0.05); }
    .header { text-align: center; padding-bottom: 24px; border-bottom: 1px solid #e2e8f0; }
    .logo { font-size: 20px; font-weight: 700; color: #e11d48; letter-spacing: -0.02em; text-transform: uppercase; }
    .title { font-size: 22px; font-weight: 700; color: #0f172a; margin-top: 16px; margin-bottom: 8px; }
    .subtitle { font-size: 14px; color: #64748b; margin: 0; }
    .content { padding: 24px 0; }
    .text-greeting { font-size: 15px; color: #1e293b; font-weight: 600; }
    .text-body { font-size: 14px; color: #475569; line-height: 1.6; }
    .rejection-card { background-color: #fff1f2; border: 1.5px solid #f43f5e; border-radius: 12px; padding: 20px; text-align: left; margin: 20px 0; }
    .rejection-title { font-size: 13px; font-weight: 700; color: #e11d48; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.05em; }
    .rejection-text { font-size: 13.5px; color: #881337; line-height: 1.5; margin: 0; }
    .info-table { width: 100%; border-collapse: collapse; margin-top: 16px; }
    .info-table td { padding: 10px 0; border-bottom: 1px solid #e2e8f0; font-size: 14px; }
    .info-label { color: #64748b; }
    .info-value { color: #0f172a; font-weight: 600; text-align: right; }
    .btn-container { text-align: center; margin-top: 28px; }
    .btn { display: inline-block; background-color: #e11d48; color: #ffffff !important; text-decoration: none; font-weight: 600; font-size: 14px; padding: 12px 28px; border-radius: 9999px; }
    .footer { text-align: center; font-size: 12px; color: #64748b; margin-top: 32px; padding-top: 16px; border-top: 1px solid #e2e8f0; }

    @media (prefers-color-scheme: dark) {
      body { background-color: #0f172a !important; color: #f8fafc !important; }
      .container { background-color: #1e293b !important; border-color: #334155 !important; }
      .header { border-bottom-color: #334155 !important; }
      .logo { color: #fb7185 !important; }
      .title { color: #ffffff !important; }
      .subtitle { color: #94a3b8 !important; }
      .text-greeting { color: #f8fafc !important; }
      .text-body { color: #94a3b8 !important; }
      .rejection-card { background-color: #0f172a !important; border-color: #f43f5e !important; }
      .rejection-title { color: #fb7185 !important; }
      .rejection-text { color: #f8fafc !important; }
      .info-table td { border-bottom-color: #334155 !important; }
      .info-label { color: #94a3b8 !important; }
      .info-value { color: #ffffff !important; }
      .footer { color: #64748b !important; border-top-color: #334155 !important; }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <div class="logo">
        <img src="<%= locals.logo_url || 'https://thetradefactor.com/images/logo.png' %>" alt="E-Embassy" style="height: 38px; width: auto; max-width: 220px; border: 0; display: inline-block; vertical-align: middle;" />
      </div>
      <h1 class="title">Application Status Update</h1>
      <p class="subtitle">An update regarding application <%= application_no %></p>
    </div>

    <div class="content">
      <p class="text-greeting">Dear <%= recipient_name %>,</p>
      <p class="text-body">
        We regret to inform you that your application <strong><%= application_no %></strong> for <strong><%= target_country %></strong> could not be approved at this time.
      </p>

      <div class="rejection-card">
        <div class="rejection-title">Reason Provided by Reviewer</div>
        <p class="rejection-text"><%= rejection_reason || 'Documentation did not satisfy mandatory embassy requirements.' %></p>
      </div>

      <table class="info-table">
        <tr>
          <td class="info-label">Application Reference</td>
          <td class="info-value" style="font-family: monospace;"><%= application_no %></td>
        </tr>
        <tr>
          <td class="info-label">Status</td>
          <td class="info-value" style="color: #e11d48;">Rejected</td>
        </tr>
      </table>

      <div class="btn-container">
        <a href="<%= tracking_url %>" class="btn">View Details & Resubmit</a>
      </div>
    </div>

    <div class="footer">
      <p>© <%= year %> E-Embassy. All rights reserved.</p>
      <p>Sent from <%= from_email %></p>
    </div>
  </div>
</body>
</html>
