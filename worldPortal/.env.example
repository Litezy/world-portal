# Application Server Config
PORT=3000
NODE_ENV=development

# PostgreSQL & Prisma Database Config
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/world_portal_db?schema=public&connect_timeout=30&pool_timeout=30&connection_limit=10"

# Redis & BullMQ Queue Config
REDIS_HOST=localhost
REDIS_PORT=6379

# External Authentication Service Config
EXTERNAL_AUTH_SERVICE_URL=https://auth.example.com
# Signs and verifies every desk token. This value is for local use only: in
# production the API refuses to start unless JWT_SECRET is a private random
# value of 32+ characters (e.g. `openssl rand -base64 48`).
JWT_SECRET=world-portal-secret-key-2026

# Dev / Mock Auth. Off when unset. "true" lets anyone get a token from
# POST /auth/test-token, so only ever set it locally — never where real
# applicants are.
ENABLE_MOCK_AUTH=true
DEFAULT_MANAGER_EMAIL=manager@loveworld.com
DEFAULT_MANAGER_EXTERNAL_AUTH_ID=external-auth-manager-001

# Shared with the admin console's server (its SERVICE_AUTH_KEY). With mock auth
# off, POST /auth/test-token only issues tokens to a caller sending this as the
# `x-service-key` header. 32+ characters; unset means nobody qualifies.
SERVICE_AUTH_KEY=

# Demo-data seed (POST /seed). Answers 404 unless ENABLE_SEED_ENDPOINT=true and
# then needs SEED_SECRET_CODE (no default). Never enable on real data.
# ENABLE_SEED_ENDPOINT=true
# SEED_SECRET_CODE=

# OpenAPI docs at /api/docs are served outside production; in production only
# when this is "true".
# ENABLE_SWAGGER=true

# Optional: a fixed MANAGER JWT (2-day expiry) for quick local testing, so you
# don't have to call POST /auth/test-token every time. Generate your own with:
#   node -e "console.log(require('jsonwebtoken').sign({ sub: '<DEFAULT_MANAGER_EXTERNAL_AUTH_ID>', externalAuthId: '<DEFAULT_MANAGER_EXTERNAL_AUTH_ID>', email: '<DEFAULT_MANAGER_EMAIL>', iss: 'world-portal-auth' }, '<JWT_SECRET>', { expiresIn: '2d' }))"
# Use as: Authorization: Bearer $TEST_MANAGER_TOKEN — regenerate every 2 days.
TEST_MANAGER_TOKEN=

# Pluggable Document Storage Provider (s3 or cloudinary)
STORAGE_PROVIDER=s3

# AWS S3 Storage Config for Document Uploads
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET_NAME=world-portal-documents
AWS_S3_CUSTOM_DOMAIN=https://documents.worldportal.com

# Cloudinary Storage Config for Document Uploads
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=world-portal-documents

# Frontend Application Web URL (Used for email tracking and payment links)
FRONTEND_URL=http://localhost:3000

# RapidAPI Visa Requirement API Config
RAPIDAPI_VISA_REQUIREMENT_HOST=visa-requirement.p.rapidapi.com
RAPIDAPI_VISA_REQUIREMENT_KEY=your-rapidapi-key
RAPIDAPI_VISA_REQUIREMENT_BASE_URL=https://visa-requirement.p.rapidapi.com

# SendGrid Email Service Config
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@thetradefactor.com
SENDGRID_FROM_NAME="World Portal | The Trade Factor"

# WorldStreet sign-in (applicants). The SAME Clerk instance as the WorldStreet
# app and this API's frontend. Session tokens forwarded as `Authorization:
# Bearer` are verified with these; with neither key set every applicant
# request is refused (401) and the log says why.
CLERK_SECRET_KEY=
# Optional: the instance's PEM public key — verification then needs no network.
# CLERK_JWT_KEY=
# Comma-separated origins allowed to have minted the token (the E-Embassy site).
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000
